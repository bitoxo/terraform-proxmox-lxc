# Copy to terraform.tfvars and fill in your values.

proxmox_host      = "192.168.1.100"
proxmox_node      = "pve"
proxmox_api_token = "root@pam!terraform=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
ssh_public_key    = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA..."   # cat ~/.ssh/id_ed25519.pub
gateway           = "192.168.1.1"
dns_servers       = ["192.168.1.1"]
storage           = "local-lvm"

# Datastore where the LXC template tarball is stored.
# Must support content type "vztmpl". On most setups this is "local".
# Check yours: pvesm status --content vztmpl
# template_datastore_id = "local"

# Uncomment if your containers are on a tagged VLAN:
# vlan_tag = 10
